{
  "version": "0.11.0",
  "description": "Idiomatic export names for contract snake_case operations per language.",
  "languages": {
    "rust": { "style": "snake_case", "examples": { "format": "format_datetime", "parse": "parse_datetime", "object.compact": "compact_map", "money.format_money": "format_money" } },
    "typescript": { "style": "camelCase", "examples": { "format": "formatDatetime", "parse": "parseDatetime", "object.compact": "compactObject", "money.format_money": "formatMoney" } },
    "python": { "style": "snake_case", "examples": { "round": "round_number", "object.compact": "compact_map", "money.format_money": "format_money" } },
    "go": { "style": "PascalCase", "examples": { "format": "FormatDatetime", "parse": "ParseDatetime", "collection.compact": "CompactAny", "object.compact": "CompactMap", "money.format_money": "FormatMoney" } },
    "java": { "style": "camelCase on Utils class", "examples": { "format": "formatDatetime", "parse": "parseDatetime", "money.format_money": "formatMoney on MoneyUtils" } },
    "kotlin": { "style": "camelCase on Utils object", "examples": { "format": "formatDatetime", "parse": "parseDatetime", "money.format_money": "formatMoney on MoneyUtils" } },
    "csharp": { "style": "PascalCase", "examples": { "result.ok": "ResultValue.Success", "result.err": "ResultValue.Failure", "money.format_money": "FormatMoney" } },
    "php": { "style": "camelCase static methods", "examples": { "format": "formatDatetime", "parse": "parseDatetime", "money.format_money": "MoneyUtils::formatMoney" } }
  }
}
